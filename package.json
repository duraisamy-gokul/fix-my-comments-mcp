{
  "name": "fix-my-comments-mcp",
  "version": "1.0.0",
  "description": "MCP server for Fix My Comments — exposes code review tasks to AI agents via the Model Context Protocol.",
  "keywords": ["mcp", "ai", "code-review", "comments", "tasks"],
  "license": "MIT",
  "bin": {
    "fix-my-comments": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": ["dist"],
  "scripts": {
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check-types && npm run lint && npm run format:check && npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1"
  }
}
